# Copy to .env for local overrides. .env is gitignored. Never commit real secrets.
# All values here are optional: the defaults target the GitHub Pages prototype.

# Canonical origin of the deployed site (no path).
# Default: derived from the git remote / GITHUB_REPOSITORY -> https://<owner>.github.io
# Production: https://basblokland.com
# SITE_URL=

# Path the site is served from, with leading and trailing slash.
# Default: derived from the repo name -> /<repo>/   (GitHub Pages project site)
# Production: /
# BASE_PATH=

# Content source. With SANITY_PROJECT_ID the build reads PUBLISHED content from Sanity (the dataset must
# be public; no token is ever used). Without it the site builds from the local placeholder fixtures.
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# CONTENT_SOURCE=fixtures   # force the fixtures even when a project id is set (local design work)

# Prototype mode: noindex/nofollow meta, no sitemap, placeholder fixtures allowed.
# Unset or any value other than "true" = production behaviour.
# PUBLIC_PROTOTYPE=true
