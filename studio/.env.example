# Copy to studio/.env (gitignored) and fill in. See docs/studio.md for how to get these.

# The Sanity project id (from https://www.sanity.io/manage, or printed by `npx sanity init`).
SANITY_STUDIO_PROJECT_ID=

# The dataset. Keep it "production" and PUBLIC: the website reads published content without a token.
SANITY_STUDIO_DATASET=production

# Hostname of the hosted Studio: https://<host>.sanity.studio (letters, numbers, dashes).
SANITY_STUDIO_HOST=
