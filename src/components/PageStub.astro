---
// Temporary page body used until each page is built in the pages step.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="px-page pb-space-xl pt-space-md">
  <h1 class="font-headline-xl-mobile text-headline-xl-mobile lowercase text-primary md:text-headline-xl">
    {title}
  </h1>
  <p class="mt-space-sm font-meta-mono text-meta-mono uppercase text-outline">
    [ placeholder page / content follows ]
  </p>
</section>
