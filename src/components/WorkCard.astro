---
/**
 * Index card (home stacks, jewelry). The cover may be cropped to a fixed height here; detail
 * pages show images uncropped. The image + title is one link; ENQUIRE is a separate link, because
 * links cannot be nested.
 */
import { sections } from '../lib/site';
import { workIndex } from '../lib/content';
import { url } from '../lib/url';
import type { Work } from '../lib/types';
import EnquireLink from './EnquireLink.astro';
import Img from './Img.astro';
import StatusTag from './StatusTag.astro';

interface Props {
  work: Work;
  /** Offer an ENQUIRE mailto link (jewelry that can still be had). */
  enquire?: boolean;
  class?: string;
}
const { work, enquire = false, class: className = '' } = Astro.props;
const no = `${sections[work.section].no}.${workIndex(work)}`;
const spec = [work.medium, work.dimensions].filter(Boolean).join(' / ');
---

<article class:list={['flex flex-col', className]} data-placeholder={work.isPlaceholder ? '' : undefined}>
  <a href={url(`${work.section}/${work.slug}`)} class="group flex flex-col">
    <div class="overflow-hidden bg-surface-container">
      <Img image={work.cover} class="h-72 w-full object-cover md:h-80" />
    </div>
    <div class="mt-space-sm flex items-baseline justify-between gap-space-md font-meta-mono text-meta-mono uppercase text-outline">
      <span>[{no}]</span>
      {work.year && <span>{work.year}</span>}
    </div>
    <h3 class="mt-space-xs font-headline-md text-body-lg lowercase text-primary group-hover:text-secondary">
      {work.title}
    </h3>
    {spec && <p class="mt-space-xs font-meta-mono text-meta-mono uppercase text-outline">{spec}</p>}
  </a>
  {
    (work.status || enquire) && (
      <div class="flex items-center justify-between gap-space-md">
        {work.status && <StatusTag status={work.status} />}
        {enquire && <EnquireLink about={work.title} />}
      </div>
    )
  }
</article>
