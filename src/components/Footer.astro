---
/**
 * Compact footer bar. It lives in the pinned bottom dock (see BaseLayout), so this line stays in
 * view while the page scrolls. Just one contact line: the Instagram handle (the full contact
 * details live on /contact). Without an Instagram handle it falls back to the e-mail address, so the
 * footer is never empty. The © line is dropped on phones to save height.
 */
import { getSiteSettings } from '../lib/content';
import { wordmark } from '../lib/site';

const settings = getSiteSettings();
const { email, instagram } = settings;
const year = new Date().getFullYear();
const linkClass = 'inline-flex min-h-11 items-center hover:text-secondary';
---

<footer class="border-t border-outline-variant bg-surface-container-high px-page">
  <div
    class="mx-auto flex max-w-[90rem] items-center justify-between gap-x-space-lg font-meta-mono text-meta-mono uppercase text-on-surface-variant"
  >
    {
      instagram ? (
        <a class={linkClass} href={`https://instagram.com/${instagram}`} rel="noopener" target="_blank">
          @{instagram}
        </a>
      ) : (
        email && (
          <a class={linkClass} href={`mailto:${email}`} data-placeholder={settings.isPlaceholder ? '' : undefined}>
            {email}
          </a>
        )
      )
    }
    <p class="hidden text-outline md:block">© {year} {wordmark}</p>
  </div>
</footer>
