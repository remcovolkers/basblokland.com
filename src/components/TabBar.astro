---
import { isActive, navItems } from '../lib/site';
import { url } from '../lib/url';

const pathname = Astro.url.pathname;
---

<!--
  Mobile tab bar, the bottom row of the pinned dock (BaseLayout). It can wrap at large text sizes.
-->
<nav aria-label="Main" class="border-t border-outline-variant bg-surface-container-high pb-safe md:hidden">
  <ul class="flex min-h-13 flex-wrap items-center justify-between px-gutter">
    {
      navItems.map((item) => {
        const active = isActive(item, pathname);
        return (
          <li>
            <a
              href={url(item.href)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex min-h-11 min-w-11 items-center justify-center px-space-xs font-meta-mono text-meta-mono uppercase hover:text-secondary',
                active ? 'text-secondary underline underline-offset-4' : 'text-on-surface-variant',
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
