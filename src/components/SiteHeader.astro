---
import { isActive, navItems, wordmark } from '../lib/site';
import { url } from '../lib/url';

const pathname = Astro.url.pathname;
const onHome = pathname === url('/');
---

<header class="sticky top-0 z-40 border-b border-outline-variant bg-surface-container-high pt-safe">
  <div class="mx-auto flex min-h-16 max-w-[90rem] items-center justify-between gap-space-md px-page">
    <a
      href={url('/')}
      aria-current={onHome ? 'page' : undefined}
      class="flex min-h-11 items-center font-headline-md text-body-lg font-bold lowercase tracking-tight text-primary hover:text-secondary"
    >
      {wordmark}
    </a>

    <!-- Desktop / tablet navigation. On mobile the same links live in the bottom tab bar. -->
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-space-lg">
        {
          navItems.map((item) => {
            const active = isActive(item, pathname);
            return (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 min-w-11 items-center justify-center font-meta-mono text-meta-mono uppercase hover:text-secondary',
                    active ? 'text-secondary underline underline-offset-4' : 'text-on-surface-variant',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
