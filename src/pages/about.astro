---
import CvGroup from '../components/CvGroup.astro';
import EmptyState from '../components/EmptyState.astro';
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout } from '../lib/content';

const about = getAbout();
---

<BaseLayout title="about">
  <div class="border-b border-outline-variant px-page py-space-xs">
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile lowercase text-primary md:text-headline-lg">about</h1>
  </div>
  <!-- lg: three columns (portrait | bio | CV) so it fits one screen. Below lg: stacked, with a
       small portrait and the CV groups collapsed (see the script). -->
  {
    about ? (
      <div
        class="grid grid-cols-1 gap-space-sm px-page py-space-sm lg:grid-cols-12 lg:gap-gutter-desktop"
        data-placeholder={about.isPlaceholder ? '' : undefined}
      >
        {about.portrait && (
          <figure class="lg:col-span-3">
            <Img
              image={about.portrait}
              class="h-auto max-h-[30dvh] w-auto max-w-full lg:max-h-[60dvh]"
              sizes="(min-width: 64rem) 25vw, 60vw"
              loading="eager"
            />
            {about.portrait.caption && (
              <figcaption class="pt-space-xs font-meta-mono text-meta-mono uppercase text-outline">
                {about.portrait.caption}
              </figcaption>
            )}
          </figure>
        )}
        <div
          class:list={[
            'flex max-w-prose flex-col gap-space-sm text-body-md text-on-surface',
            about.portrait ? 'lg:col-span-5' : 'lg:col-span-8',
          ]}
        >
          {about.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {about.cvGroups.length > 0 && (
          <div class="flex flex-col lg:col-span-4">
            {about.cvGroups.map((group) => <CvGroup group={group} />)}
          </div>
        )}
      </div>
    ) : (
      <EmptyState />
    )
  }
</BaseLayout>

<script>
  // Below lg the CV groups start collapsed to keep the page short. They are open in the markup, so
  // without JavaScript (and on desktop) everything is visible.
  if (!window.matchMedia('(min-width: 64rem)').matches) {
    document.querySelectorAll('details[data-cv-group]').forEach((group) => group.removeAttribute('open'));
  }
</script>
