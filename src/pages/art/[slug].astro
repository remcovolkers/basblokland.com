---
import type { GetStaticPaths } from 'astro';
import WorkDetail from '../../components/WorkDetail.astro';
import WorkNav from '../../components/WorkNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks } from '../../lib/content';

export const getStaticPaths = (() =>
  getWorks('art').map((work) => ({ params: { slug: work.slug }, props: { work } }))) satisfies GetStaticPaths;

const { work } = Astro.props;
---

<!-- Detail pages: no mobile tab bar (like the Stitch detail screen); the pinned sub-header has the way back. -->
<BaseLayout title={work.title} tabBar={false} {...work.shortText ? { description: work.shortText } : {}}>
  <WorkNav slot="subheader" work={work} />
  <WorkDetail work={work} />
</BaseLayout>
