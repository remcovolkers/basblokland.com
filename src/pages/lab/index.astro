---
import EmptyState from '../../components/EmptyState.astro';
import LabEntryItem from '../../components/LabEntryItem.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLabEntries } from '../../lib/content';
import { sections } from '../../lib/site';

const entries = getLabEntries();
---

<BaseLayout title="lab">
  <div class="border-b border-outline-variant px-page py-space-xs">
    <SectionHeader as="h1" no={sections.lab.no} title={sections.lab.label} count={entries.length} />
  </div>
  {
    entries.length > 0 ? (
      <div class="flex flex-col gap-space-xs px-page py-space-sm md:grid md:grid-cols-2 md:items-start md:gap-gutter lg:grid-cols-3">
        {entries.map((entry) => <LabEntryItem entry={entry} />)}
      </div>
    ) : (
      <EmptyState />
    )
  }
</BaseLayout>
