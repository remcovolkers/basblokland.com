---
import WorksIndex from '../../components/WorksIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks } from '../../lib/content';
import { sections } from '../../lib/site';

const works = getWorks('jewelry');
---

<BaseLayout title="jewelry">
  <!-- The intro is a plain instruction, not a claim about the work. Wording to be confirmed with Bas. -->
  <WorksIndex
    works={works}
    no={sections.jewelry.no}
    title={sections.jewelry.label}
    defaultView="grid"
    intro="Jewelry is not sold through a shop. To buy or commission a piece, get in touch."
  />
</BaseLayout>
