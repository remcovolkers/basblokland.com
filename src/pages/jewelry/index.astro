---
import EmptyState from '../../components/EmptyState.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import WorksIndex from '../../components/WorksIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks } from '../../lib/content';
import { sections } from '../../lib/site';

const works = getWorks('jewelry');
---

<BaseLayout title="jewelry">
  <div class="flex flex-col gap-space-sm px-page pb-space-md pt-space-md">
    <SectionHeader as="h1" no={sections.jewelry.no} title={sections.jewelry.label} />
    <!-- Plain instruction, not a claim about the work. Wording to be confirmed with Bas. -->
    <p class="max-w-prose font-meta-mono text-meta-mono uppercase text-on-surface-variant">
      Jewelry is not sold through a shop. To buy or commission a piece, get in touch.
    </p>
  </div>
  {works.length > 0 ? <WorksIndex works={works} defaultView="grid" /> : <EmptyState />}
</BaseLayout>
