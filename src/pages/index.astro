---
import HomeSection from '../components/HomeSection.astro';
import LabEntryItem from '../components/LabEntryItem.astro';
import LogoMark from '../components/LogoMark.astro';
import WorkRowCompact from '../components/WorkRowCompact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLabEntries, getSiteSettings, getWorks } from '../lib/content';
import { sections, wordmark } from '../lib/site';
import { url } from '../lib/url';

const settings = getSiteSettings();
const art = getWorks('art');
const jewelry = getWorks('jewelry');
const lab = getLabEntries();
// Without a confirmed statement the page still needs its h1: fall back to the artist's name.
const statement = settings.homeStatement ?? wordmark;
const placeholder = settings.isPlaceholder ? '' : undefined;
const anySection = art.length + jewelry.length + lab.length > 0;
---

<BaseLayout>
  <!-- Compact hero: statement left, logo right. -->
  <section class="flex items-center justify-between gap-space-md px-page pb-space-sm pt-space-sm md:pb-space-md md:pt-space-md">
    <div class="flex min-w-0 flex-col gap-space-xs">
      {
        settings.statusLine && (
          <p class="font-meta-mono text-meta-mono uppercase text-secondary" data-placeholder={placeholder}>
            [ status: {settings.statusLine} ]
          </p>
        )
      }
      <h1
        class="font-headline-lg-mobile text-headline-lg-mobile lowercase text-primary md:text-headline-xl"
        data-placeholder={placeholder}
      >
        {statement}
      </h1>
    </div>
    <LogoMark class="h-20 w-auto shrink-0 text-primary md:h-36" />
  </section>

  <!-- Three sections: side by side on desktop (fits one screen), stacked compact rows on a phone. -->
  {
    anySection && (
      <div class="grid grid-cols-1 gap-x-gutter gap-y-space-sm px-page pb-space-sm md:grid-cols-3">
        {art.length > 0 && (
          <HomeSection no={sections.art.no} title={sections.art.label} count={art.length} href={url(sections.art.href)} linkLabel="view all art">
            {art.slice(0, 3).map((work, i) => (
              <div class={i >= 2 ? 'hidden md:block' : ''}>
                <WorkRowCompact work={work} />
              </div>
            ))}
          </HomeSection>
        )}
        {jewelry.length > 0 && (
          <HomeSection no={sections.jewelry.no} title={sections.jewelry.label} count={jewelry.length} href={url(sections.jewelry.href)} linkLabel="view all jewelry">
            {jewelry.slice(0, 3).map((work, i) => (
              <div class={i >= 2 ? 'hidden md:block' : ''}>
                <WorkRowCompact work={work} />
              </div>
            ))}
          </HomeSection>
        )}
        {lab.length > 0 && (
          <HomeSection no={sections.lab.no} title={sections.lab.label} count={lab.length} href={url(sections.lab.href)} linkLabel="enter lab">
            <div class="flex flex-col gap-space-xs pt-space-xs">
              {lab.slice(0, 3).map((entry, i) => (
                <div class={i >= 2 ? 'hidden md:block' : ''}>
                  <LabEntryItem entry={entry} />
                </div>
              ))}
            </div>
          </HomeSection>
        )}
      </div>
    )
  }

  {
    settings.colophon && (
      <p class="max-w-prose px-page pb-space-sm text-body-sm text-on-surface-variant" data-placeholder={placeholder}>
        {settings.colophon}
      </p>
    )
  }
</BaseLayout>
