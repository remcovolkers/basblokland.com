---
import EmptyState from '../components/EmptyState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

// No contact form: the site is static with no backend, so contact is plain links.
const { email, instagram, isPlaceholder } = getSiteSettings();
const placeholder = isPlaceholder ? '' : undefined;
const linkClass = 'inline-flex min-h-11 items-center text-on-surface hover:text-secondary';
---

<BaseLayout title="contact">
  <div class="border-b border-outline-variant px-page py-space-xs">
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile lowercase text-primary md:text-headline-lg">contact</h1>
  </div>
  {
    email || instagram ? (
      <dl class="flex flex-col px-page py-space-sm font-meta-mono text-meta-mono uppercase md:max-w-xl">
        {email && (
          <div class="flex flex-col border-t border-outline-variant py-space-xs" data-placeholder={placeholder}>
            <dt class="text-outline">e-mail</dt>
            <dd>
              <a class={linkClass} href={`mailto:${email}`}>
                {email}
              </a>
            </dd>
          </div>
        )}
        {instagram && (
          <div class="flex flex-col border-t border-outline-variant py-space-xs" data-placeholder={placeholder}>
            <dt class="text-outline">instagram</dt>
            <dd>
              <a class={linkClass} href={`https://instagram.com/${instagram}`} rel="noopener" target="_blank">
                @{instagram}
              </a>
            </dd>
          </div>
        )}
      </dl>
    ) : (
      <EmptyState />
    )
  }
</BaseLayout>
